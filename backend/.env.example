# Database Connection String (PostgreSQL or SQLite fallback)
DATABASE_URL=postgresql://postgres:password@localhost:5432/aihealthverse

# Google Gemini API Key for Generative AI Features & Multimodal Vision OCR
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here

# Optional External Cloud OCR API
EXTERNAL_OCR_API_KEY=
